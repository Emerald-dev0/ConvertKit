{
  "name": "@convertkit/cli",
  "version": "0.1.0",
  "description": "Command-line interface for ConvertKit",
  "type": "module",
  "bin": {
    "convertkit": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js"
  },
  "dependencies": {
    "@convertkit/converter-csv-json": "workspace:*",
    "@convertkit/converter-ffmpeg": "workspace:*",
    "@convertkit/converter-image": "workspace:*",
    "@convertkit/converter-markdown-html": "workspace:*",
    "@convertkit/converter-ocr": "workspace:*",
    "@convertkit/converter-office-pdf": "workspace:*",
    "@convertkit/converter-pdf-text": "workspace:*",
    "@convertkit/core": "workspace:*",
    "chalk": "^5.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "typescript": "^5.0.0"
  },
  "author": "ConvertKit Contributors",
  "license": "MIT"
}
